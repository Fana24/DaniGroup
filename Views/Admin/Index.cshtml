<div class="page-banner">
    <h2>Admin Dashboard</h2>
    <p class="text-muted-custom mb-0">Manage products, orders, returns, and customer messages.</p>
</div>

<div class="row g-4">
    <div class="col-md-3">
        <a asp-action="Products" class="text-decoration-none">
            <div class="dashboard-card">
                <h4>Products</h4>
                <p>Manage product listings and pricing.</p>
            </div>
        </a>
    </div>

    <div class="col-md-3">
        <a asp-action="Orders" class="text-decoration-none">
            <div class="dashboard-card">
                <h4>Orders</h4>
                <p>Track and update customer orders.</p>
            </div>
        </a>
    </div>

    <div class="col-md-3">
        <a asp-action="Returns" class="text-decoration-none">
            <div class="dashboard-card">
                <h4>Returns</h4>
                <p>Review customer return requests.</p>
            </div>
        </a>
    </div>

    <div class="col-md-3">
        <a asp-action="Messages" class="text-decoration-none">
            <div class="dashboard-card">
                <h4>Messages</h4>
                <p>View contact form submissions.</p>
            </div>
        </a>
    </div>
</div>