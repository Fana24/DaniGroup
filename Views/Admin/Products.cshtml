@model IEnumerable<DaniGroup.Models.Product>

<div class="page-banner d-flex flex-column flex-md-row justify-content-between align-items-md-center">
    <div>
        <h2>Manage Products</h2>
        <p class="text-muted-custom mb-0">Control your product catalog, pricing, and stock.</p>
    </div>
    <div class="mt-3 mt-md-0">
        <a asp-action="AddProduct" class="btn btn-dani-primary">Add New Product</a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="form-box">
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Category</th>
                <th>Price</th>
                <th>Stock</th>
                <th>Featured</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td>@product.Name</td>
                    <td>@product.Category?.Name</td>
                    <td>R @product.Price.ToString("N2")</td>
                    <td>@product.StockQuantity</td>
                    <td>@product.IsFeatured</td>
                    <td>
                        <a asp-action="EditProduct" asp-route-id="@product.Id" class="btn btn-primary btn-sm">Edit</a>

                        <form asp-action="DeleteProduct" method="post" style="display:inline;"
                              onsubmit="return confirm('Are you sure you want to delete this product?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@product.Id" />
                            <button class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>