@model IEnumerable<DaniGroup.Models.Order>

<h2>Manage Orders</h2>

<div class="form-box">
    <table class="table">
        <thead>
            <tr>
                <th>Order ID</th>
                <th>Customer</th>
                <th>Email</th>
                <th>Status</th>
                <th>Date</th>
                <th>Total</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.Id</td>
                    <td>@order.FullName</td>
                    <td>@order.Email</td>
                    <td>@order.OrderStatus</td>
                    <td>@order.CreatedAt.ToString("yyyy-MM-dd")</td>
                    <td>R @order.TotalAmount.ToString("N2")</td>
                    <td>
                        <a asp-action="OrderDetails" asp-route-id="@order.Id" class="btn btn-dani-primary btn-sm">Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>