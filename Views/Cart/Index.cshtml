@model IEnumerable<DaniGroup.Models.CartItem>

<div class="page-banner">
    <h2>Your Cart</h2>
    <p class="text-muted-custom mb-0">Review your selected products before checkout.</p>
</div>

<div class="form-box">
    @if (!Model.Any())
    {
        <p>Your cart is empty.</p>
        <a asp-controller="Products" asp-action="Index" class="btn btn-dani-primary mt-2">Start Shopping</a>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Price</th>
                    <th>Quantity</th>
                    <th>Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Product?.Name</td>
                        <td>R @((item.Product?.Price ?? 0).ToString("N2"))</td>
                        <td>@item.Quantity</td>
                        <td>R @(((item.Product?.Price ?? 0) * item.Quantity).ToString("N2"))</td>
                        <td>
                            <form asp-action="Remove" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <button class="btn btn-danger btn-sm">Remove</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="text-end mt-3">
            <a asp-controller="Checkout" asp-action="Index" class="btn btn-dani-primary">Proceed to Checkout</a>
        </div>
    }
</div>