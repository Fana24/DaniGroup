@model IEnumerable<DaniGroup.Models.ServiceItem>

<div class="page-banner">
    <h2>Dropper Services</h2>
    <p class="text-muted-custom mb-0">Reliable transport, towing, and delivery support from Dani Group.</p>
</div>

<div class="form-box mb-4">
    <p class="mb-0">
        Dani Group Dropper is built to help customers move parcels, furniture,
        vehicles, and more with dependable support and service access.
    </p>
</div>

<div class="row">
    @foreach (var service in Model)
    {
        <div class="col-md-6 mb-4">
            <div class="card dani-card h-100">
                <div class="card-body d-flex flex-column">
                    <h4>@service.Title</h4>
                    <p class="flex-grow-1">@service.Description</p>

                    @if (service.Title == "Become a Driver")
                    {
                        <a asp-controller="Contact" asp-action="Index" class="btn btn-dani-primary">Apply / Contact Us</a>
                    }
                    else
                    {
                        <a asp-controller="Contact" asp-action="Index" class="btn btn-dani-outline">Request Service</a>
                    }
                </div>
            </div>
        </div>
    }
</div>