@model DaniGroup.Models.Order

<div class="form-box text-center">
    <h2>Payment Cancelled</h2>
    <p>Your payment was cancelled or not completed.</p>

    <p><strong>Order ID:</strong> @Model.Id</p>
    <p><strong>Payment Status:</strong> @Model.PaymentStatus</p>
    <p><strong>Order Status:</strong> @Model.OrderStatus</p>

    <div class="mt-3">
        <a asp-controller="Checkout" asp-action="Index" class="btn btn-dani-primary me-2">Try Again</a>
        <a asp-controller="Cart" asp-action="Index" class="btn btn-dani-outline">Back to Cart</a>
    </div>
</div>