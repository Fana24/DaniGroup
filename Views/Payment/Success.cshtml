@model DaniGroup.Models.Order

<div class="form-box text-center">
    <h2>Payment Successful</h2>
    <p>Your Yoco payment was completed successfully.</p>

    <p><strong>Order ID:</strong> @Model.Id</p>
    <p><strong>Payment Provider:</strong> @Model.PaymentProvider</p>
    <p><strong>Payment Status:</strong> @Model.PaymentStatus</p>
    <p><strong>Order Status:</strong> @Model.OrderStatus</p>
    <p><strong>Total:</strong> R @Model.TotalAmount.ToString("N2")</p>

    <div class="mt-3">
        <a asp-controller="Orders" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-dani-primary me-2">View Order</a>
        <a asp-controller="Products" asp-action="Index" class="btn btn-dani-outline">Continue Shopping</a>
    </div>
</div>