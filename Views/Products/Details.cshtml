@model DaniGroup.Models.Product

<div class="page-banner">
    <h2>@Model.Name</h2>
    <p class="text-muted-custom mb-0">Detailed product view</p>
</div>

<div class="form-box mb-4">
    <div class="row">
        <div class="col-md-6 mb-4 mb-md-0">
            @if (!string.IsNullOrEmpty(Model.ImagePath))
            {
                <img src="@Model.ImagePath" class="img-fluid rounded" alt="@Model.Name" />
            }
        </div>

        <div class="col-md-6">
            <h2>@Model.Name</h2>
            <p>@Model.Description</p>
            <p><strong>Category:</strong> @Model.Category?.Name</p>
            <p><strong>Price:</strong> R @Model.Price.ToString("N2")</p>

            @if (Model.StockQuantity <= 0)
            {
                <p class="stock-out"><strong>Out of Stock</strong></p>
            }
            else if (Model.StockQuantity <= 5)
            {
                <p class="stock-low"><strong>Low Stock:</strong> Only @Model.StockQuantity left</p>
            }
            else
            {
                <p class="stock-good"><strong>In Stock</strong></p>
            }

            @if (Model.StockQuantity > 0)
            {
                <form asp-controller="Cart" asp-action="AddToCart" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@Model.Id" />

                    <div class="mb-3">
                        <label>Quantity</label>
                        <input type="number" name="quantity" value="1" min="1" max="@Model.StockQuantity" class="form-control" />
                    </div>

                    <button type="submit" class="btn btn-dani-primary">Add to Cart</button>
                </form>
            }
            else
            {
                <button class="btn btn-secondary" disabled>Currently Unavailable</button>
            }
        </div>
    </div>
</div>

<partial name="_ProductReviewsPartial" model="Model" />