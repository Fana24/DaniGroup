@model IEnumerable<DaniGroup.Models.Product>

<div class="page-banner">
    <h2>Online Store</h2>
    <p class="text-muted-custom mb-0">Browse quality products from Dani Group.</p>
</div>

<div class="row">
    <div class="col-lg-3 mb-4">
        <div class="form-box">
            <h4 class="mb-3">Filter Products</h4>

            <form method="get">
                <div class="mb-3">
                    <label>Search</label>
                    <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control" placeholder="Search products..." />
                </div>

                <div class="mb-3">
                    <label>Category</label>
                    <select name="categoryId" class="form-select">
                        <option value="">All Categories</option>
                        @foreach (var category in ViewBag.Categories)
                        {
                            if (ViewBag.CategoryId != null && ViewBag.CategoryId == category.Id)
                            {
                                <option value="@category.Id" selected>@category.Name</option>
                            }
                            else
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label>Min Price</label>
                    <input type="number" step="0.01" name="minPrice" value="@ViewBag.MinPrice" class="form-control" />
                </div>

                <div class="mb-3">
                    <label>Max Price</label>
                    <input type="number" step="0.01" name="maxPrice" value="@ViewBag.MaxPrice" class="form-control" />
                </div>

                <div class="form-check mb-3">
                    <input type="checkbox" class="form-check-input" name="inStockOnly" value="true" @(ViewBag.InStockOnly ? "checked" : "") />
                    <label class="form-check-label">In stock only</label>
                </div>

                <button type="submit" class="btn btn-dani-primary w-100 mb-2">Apply Filters</button>
                <a asp-action="Index" class="btn btn-dani-outline w-100">Clear Filters</a>
            </form>
        </div>
    </div>

    <div class="col-lg-9">
        <div class="row">
            @if (!Model.Any())
            {
                <div class="col-12">
                    <div class="form-box">
                        <p class="mb-0">No products found matching your filters.</p>
                    </div>
                </div>
            }

            @foreach (var product in Model)
            {
                <div class="col-md-6 col-xl-4 mb-4">
                    <div class="card dani-card h-100">
                        @if (!string.IsNullOrEmpty(product.ImagePath))
                        {
                            <img src="@product.ImagePath" class="card-img-top product-image" alt="@product.Name" />
                        }

                        <div class="card-body d-flex flex-column">
                            <h5>@product.Name</h5>
                            <p class="text-muted-custom">@product.Category?.Name</p>
                            <p class="flex-grow-1">@product.Description</p>

                            @if (product.StockQuantity <= 0)
                            {
                                <p class="stock-out mb-2">Out of Stock</p>
                            }
                            else if (product.StockQuantity <= 5)
                            {
                                <p class="stock-low mb-2">Low Stock: @product.StockQuantity left</p>
                            }
                            else
                            {
                                <p class="stock-good mb-2">In Stock</p>
                            }

                            <p class="product-price">R @product.Price.ToString("N2")</p>
                            <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-dani-primary">Details</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>