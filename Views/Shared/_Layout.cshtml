<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dani Group</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="site-body">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark dani-navbar shadow-lg">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo/DA Logo1.png" asp-append-version="true" alt="Dani Group Logo" class="site-logo me-2" />
                    <div class="brand-block">
                        <span class="brand-text">Dani Group</span>
                        <small class="brand-subtext">Auto Parts • Services • Delivery</small>
                    </div>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto align-items-lg-center">
                        <li class="nav-item">
                            <a class="nav-link nav-main-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-main-link" asp-controller="Products" asp-action="Index">Store</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-main-link" asp-controller="Dropper" asp-action="Index">Dropper</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-main-link" asp-controller="Home" asp-action="About">About</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-main-link" asp-controller="Contact" asp-action="Index">Contact</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-main-link" asp-controller="Returns" asp-action="Create">Returns</a>
                        </li>
                    </ul>

                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main class="container my-4 content-wrapper">
        @RenderBody()
    </main>

    <footer class="dani-footer mt-5">
        <div class="container py-4">
            <div class="row gy-4">
                <div class="col-md-4">
                    <h5 class="footer-title">Dani Group</h5>
                    <p class="footer-text">
                        Premium auto parts, accessories, bike parts, delivery services,
                        towing, and customer-first support.
                    </p>
                </div>

                <div class="col-md-4">
                    <h5 class="footer-title">Quick Links</h5>
                    <ul class="footer-links">
                        <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li><a asp-controller="Products" asp-action="Index">Store</a></li>
                        <li><a asp-controller="Dropper" asp-action="Index">Dropper</a></li>
                        <li><a asp-controller="Home" asp-action="About">About</a></li>
                        <li><a asp-controller="Contact" asp-action="Index">Contact</a></li>
                    </ul>
                </div>

                <div class="col-md-4">
                    <h5 class="footer-title">Business Info</h5>
                    <p class="footer-text mb-1">Dani Group</p>
                    <p class="footer-text mb-1">South Africa</p>
                    <p class="footer-text mb-1">Support for parts, transport, and returns</p>
                </div>
            </div>

            <hr class="footer-line" />
            <div class="text-center footer-bottom">
                &copy; 2026 Dani Group. All rights reserved.
            </div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>