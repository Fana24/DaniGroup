@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

<ul class="navbar-nav align-items-lg-center">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <a class="nav-link nav-account-link" asp-controller="Account" asp-action="Dashboard">
                My Account
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link nav-account-link" asp-controller="Orders" asp-action="Index">
                Orders
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link nav-account-link" asp-controller="Cart" asp-action="Index">
                Cart
            </a>
        </li>

        @if (User.IsInRole("Admin"))
        {
            <li class="nav-item">
                <a class="nav-link nav-admin-link" asp-controller="Admin" asp-action="Index">
                    Admin
                </a>
            </li>
        }

        <li class="nav-item">
            <form class="d-inline" asp-area="Identity" asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Action("Index", "Home")" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-logout-nav ms-lg-2">
                    Logout
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link nav-auth-link" asp-area="Identity" asp-page="/Account/Login">
                Login
            </a>
        </li>
        <li class="nav-item">
            <a class="btn btn-register-nav ms-lg-2" asp-area="Identity" asp-page="/Account/Register">
                Register
            </a>
        </li>
    }
</ul>