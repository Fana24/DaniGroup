@model IEnumerable<DaniGroup.Models.Order>

<div class="page-banner">
    <h2>My Orders</h2>
    <p class="text-muted-custom mb-0">Track your purchases and order status.</p>
</div>

<div class="form-box">
    @if (!Model.Any())
    {
        <p>You have not placed any orders yet.</p>
        <a asp-controller="Products" asp-action="Index" class="btn btn-dani-primary mt-2">Browse Products</a>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Order ID</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Payment</th>
                    <th>Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td>#@order.Id</td>
                        <td>@order.CreatedAt.ToString("yyyy-MM-dd")</td>
                        <td>@order.OrderStatus</td>
                        <td>@order.PaymentStatus</td>
                        <td>R @order.TotalAmount.ToString("N2")</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-dani-primary btn-sm">Details</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>