@model DaniGroup.Models.ReturnRequest

<div class="page-banner">
    <h2>Request a Return</h2>
    <p class="text-muted-custom mb-0">Submit your damaged or incorrect item request with supporting details.</p>
</div>

<div class="form-box">
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label asp-for="OrderReference"></label>
            <input asp-for="OrderReference" class="form-control" />
            <span asp-validation-for="OrderReference" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Reason"></label>
            <textarea asp-for="Reason" class="form-control" rows="6"></textarea>
            <span asp-validation-for="Reason" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label>Upload Image of Damaged Product</label>
            <input type="file" name="damageImage" class="form-control" />
        </div>

        <button type="submit" class="btn btn-dani-primary">Submit Return Request</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}